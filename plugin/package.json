{
  "name": "dsh-ue-asset",
  "version": "0.1.7",
  "description": "DeepSeek Harness plugin: browse, preview and export Unreal Engine 4/5 assets from local PAK archives through CUE4Parse.",
  "icon": "icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets",
    "README.md",
    "screenshots.json",
    "vendor",
    "dist"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "unreal",
    "unreal-engine",
    "ue4",
    "ue5",
    "pak",
    "cue4parse",
    "modding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sumcam-L/dsh-ue-asset.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/Sumcam-L/dsh-ue-asset#readme",
  "bugs": {
    "url": "https://github.com/Sumcam-L/dsh-ue-asset/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "license": "MIT"
}
